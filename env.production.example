# Variables de entorno para producción
# Copia este archivo a env.production y ajusta los valores
# Este archivo se sube a S3 y se descarga en EC2

# Configuración del servidor
ENV=production
PORT=:8080

# MongoDB
MONGODB_URI=mongodb://usuario:contraseña@host:27017/ewood?authSource=admin
MONGODB_DATABASE=ewood

# PostgreSQL
POSTGRES_HOST=tu-postgres-host.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=ewood_user
POSTGRES_PASSWORD=tu_contraseña_segura
POSTGRES_DB=ewood_db
POSTGRES_SSLMODE=require

# Configuración del servidor TCP
# TCP_HOST: Host donde escuchar (vacío = todas las interfaces, por defecto: "")
# TCP_PORT: Puerto TCP para recibir actualizaciones de scooters (por defecto: 8201)
TCP_HOST=
TCP_PORT=8201

